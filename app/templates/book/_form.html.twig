
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.author) }}
    <div style="display: flex; width: 100%;">
        <div style="flex-grow: 1;">
            {{ form_row(form.category, {'attr': {'class': 'form-control'}}) }}
        </div>
        <a href="{{ path('app_category_form') }}" class="btn btn-primary" style="flex-shrink: 0; margin: 30px 0 15px 10px">
            Edit
        </a>
    </div>
    {{ form_row(form.publishedAt) }}
    {{ form_row(form.description) }}
    {{ form_row(form.isbn) }}

    <button class="btn btn-secondary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('app_book_index') }}" class="btn btn-light">Back to list</a>

    {{ form_end(form) }}