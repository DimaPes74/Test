{{ form_start(form) }}
    {{ form_widget(form) }}
<button type="submit" class="btn btn-primary">
    {{ category is defined ? 'Обновить' : 'Создать' }}
</button>
{{ form_end(form) }}
<script>
    function closeModal() {
        const modal = document.querySelector('.addCategoryModal');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }
    }
</script>